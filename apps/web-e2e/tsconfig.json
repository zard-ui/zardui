{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "outDir": "../../dist/out-tsc",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["./src/**/*.ts", "./playwright.config.ts"]
}
