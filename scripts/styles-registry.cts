/**
 * The style system's share of the registry build (ADR-0002).
 *
 * Kept in its own file so `build-registry.cts` and `check-registry.cts` only
 * call into it: the sheets are authored once, in `libs/zard/.../core/css/styles`,
 * and this turns them into everything that has to be published or bundled.
 *
 *   `splitStyledFile`    one source file → what the registry stores for it:
 *                        `content` (the default look, resolved — what every
 *                        reader that predates styles still installs unchanged)
 *                        and `styled` (the source with its markers, which the
 *                        CLI resolves into the style `components.json` names)
 *   `writeStyleArtifacts` `public/r/styles/<id>.json` + the CLI's bundled copy
 *   `checkStyleSheets`   the sheets cover every marker the sources use
 */

import * as fs from 'fs-extra';
import * as path from 'path';

import {
  DEFAULT_STYLE,
  STYLE_IDS,
  buildStyleCatalog,
  extractMarkers,
  transformStyle,
  type StyleCatalog,
  type StyleId,
} from '../packages/cli/src/core/styles/index';

/** The shape of the published style files; see `utils/schema-version.ts`. */
const STYLE_SCHEMA_VERSION = 1;

export const STYLES_DIR = path.resolve(__dirname, '../libs/zard/src/lib/shared/core/css/styles');
const LOCAL_CATALOG_FILE = path.resolve(__dirname, '../packages/cli/src/core/styles/local-catalog.ts');

function readSheet(id: StyleId): string {
  const file = path.join(STYLES_DIR, `style-${id}.css`);

  if (!fs.existsSync(file)) {
    throw new Error(`Style "${id}" has no sheet: ${file} does not exist.`);
  }

  return fs.readFileSync(file, 'utf8').replace(/\r\n/g, '\n');
}

/** Every style's marker table, complete: a marker some style leaves out is published as `''`. */
export function readStyleCatalog(): Record<StyleId, Record<string, string>> {
  const sheets = Object.fromEntries(STYLE_IDS.map(id => [id, readSheet(id)])) as Record<StyleId, string>;
  const parsed = buildStyleCatalog(sheets);
  const known = new Set<string>();

  for (const id of STYLE_IDS) for (const marker of Object.keys(parsed[id])) known.add(marker);

  const complete = {} as Record<StyleId, Record<string, string>>;
  for (const id of STYLE_IDS) {
    complete[id] = {};
    for (const marker of [...known].sort()) complete[id][marker] = parsed[id][marker] ?? '';
  }

  return complete;
}

/**
 * What the registry stores for one source file.
 *
 * `content` is always the default look resolved, so a CLI that has never heard of
 * styles — or any other reader of the JSON — gets a working file exactly as
 * before. `styled` is only present when the source has markers, and is what a
 * style-aware CLI starts from.
 */
export function splitStyledFile(source: string, catalog: StyleCatalog): { content: string; styled?: string } {
  const content = transformStyle(source, DEFAULT_STYLE, catalog);

  return content === source ? { content } : { content, styled: source };
}

/** Writes `public/r/styles/*.json` and the CLI's bundled copy of the same tables. */
export function writeStyleArtifacts(outputPath: string): void {
  const catalog = readStyleCatalog();
  const dir = path.join(outputPath, 'styles');

  fs.removeSync(dir);
  fs.ensureDirSync(dir);

  for (const id of STYLE_IDS) {
    fs.writeJsonSync(
      path.join(dir, `${id}.json`),
      {
        $schema: 'https://zardui.com/schema/style.json',
        schemaVersion: STYLE_SCHEMA_VERSION,
        id,
        markers: catalog[id],
      },
      { spaces: 2 },
    );
  }

  fs.writeJsonSync(
    path.join(dir, 'index.json'),
    {
      $schema: 'https://zardui.com/schema/styles.json',
      schemaVersion: STYLE_SCHEMA_VERSION,
      default: DEFAULT_STYLE,
      styles: [...STYLE_IDS],
    },
    { spaces: 2 },
  );

  fs.writeFileSync(LOCAL_CATALOG_FILE, renderLocalCatalog(catalog));

  const markers = Object.keys(catalog[DEFAULT_STYLE]).length;
  console.log(`   🎭 Styles: ${STYLE_IDS.length} styles, ${markers} markers each`);
}

function renderLocalCatalog(catalog: Record<StyleId, Record<string, string>>): string {
  const lines = [
    '/*',
    ' * The styles the CLI carries with it, so installing works with no registry in reach.',
    ' *',
    ' * GENERATED by scripts/build-registry.cts from libs/zard/src/lib/shared/core/css/styles/style-*.css.',
    ' * Do not edit: change the sheets and run `npm run build:registry`. The registry publishes the',
    ' * same tables at <registry>/styles/<id>.json, and that copy wins when it is reachable.',
    ' */',
    '',
    "import type { StyleCatalog } from './transform-style.js';",
    '',
    'export const LOCAL_STYLE_CATALOG: StyleCatalog = {',
  ];

  for (const id of STYLE_IDS) {
    lines.push(`  ${id}: {`);
    for (const [marker, classes] of Object.entries(catalog[id])) {
      lines.push(`    '${marker}': ${JSON.stringify(classes)},`);
    }
    lines.push('  },');
  }

  lines.push('};', '');
  return lines.join('\n');
}

/**
 * Problems with the sheets, as messages.
 *
 * A marker a source uses and a sheet does not define would install as a part
 * with no look in that style: the component renders unstyled. So every style
 * must define every marker the sources carry (an empty rule, `.cn-x { }`, is a
 * decision; a missing rule is a bug) — the default style's table is what
 * `content` is built from.
 */
export function checkStyleSheets(sources: Array<{ item: string; file: string; source: string }>): string[] {
  const problems: string[] = [];
  const parsed = buildStyleCatalog(Object.fromEntries(STYLE_IDS.map(id => [id, readSheet(id)])) as Record<StyleId, string>);
  const used = new Map<string, string>();

  for (const { item, file, source } of sources) {
    for (const marker of extractMarkers(source)) if (!used.has(marker)) used.set(marker, `${item}/${file}`);
  }

  for (const [marker, where] of used) {
    if (!(marker in parsed[DEFAULT_STYLE])) {
      problems.push(`${where}: marker "${marker}" has no rule in style-${DEFAULT_STYLE}.css`);
      continue;
    }

    for (const id of STYLE_IDS) {
      if (id !== DEFAULT_STYLE && !(marker in parsed[id])) {
        problems.push(`${where}: marker "${marker}" has no rule in style-${id}.css`);
      }
    }
  }

  // The other direction: a rule nothing uses is dead weight in every install of the docs.
  for (const marker of Object.keys(parsed[DEFAULT_STYLE])) {
    if (!used.has(marker)) problems.push(`style-${DEFAULT_STYLE}.css: rule "${marker}" is not used by any component`);
  }

  // `content` must be what the default style resolves to — nothing left over.
  for (const { item, file, source } of sources) {
    const resolved = transformStyle(source, DEFAULT_STYLE, parsed);
    if (extractMarkers(resolved).length > 0) {
      problems.push(`${item}/${file}: markers survive resolution: ${extractMarkers(resolved).join(', ')}`);
    }
  }

  return problems;
}

/**
 * Problems in the published items: `content` must be what the default style makes
 * of `styled` (it is what readers that predate styles install), and no `content`
 * may still carry a marker.
 */
export function checkPublishedItems(
  items: Array<{ name: string; files: Array<{ name: string; content: string; styled?: string }> }>,
): string[] {
  const problems: string[] = [];
  const catalog = readStyleCatalog();

  for (const item of items) {
    for (const file of item.files) {
      if (extractMarkers(file.content).length > 0) {
        problems.push(`${item.name}/${file.name}: published content still has markers`);
      }

      if (file.styled !== undefined && transformStyle(file.styled, DEFAULT_STYLE, catalog) !== file.content) {
        problems.push(`${item.name}/${file.name}: content is not the default style's resolution of styled`);
      }
    }
  }

  return problems;
}
