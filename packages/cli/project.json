{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "tags": ["type:cli"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/cli/dist"],
      "options": {
        "commands": ["node scripts/cli-build.mjs --registry https://zardui.com/r --package package.json"],
        "parallel": false
      }
    },
    "build:dev": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/cli/dist"],
      "options": {
        "commands": ["node scripts/cli-build.mjs --registry http://localhost:4223/r --package package.dev.json --link"],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/cli/jest.config.ts"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd packages/cli/dist && npm publish --access public"],
        "parallel": false
      },
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/cli/dist"
      }
    }
  }
}
