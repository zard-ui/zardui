{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@cli/*": ["./src/*"],
      "@zardui/preset": ["../preset/src/index.ts"],
      "@zardui/preset/*": ["../preset/src/*"]
    }
  },
  "include": ["./src/**/*.ts", "../preset/src/**/*.ts"],
  "exclude": [
    "./src/**/*.spec.ts",
    "./src/**/*.test.ts",
    "../preset/src/**/*.spec.ts",
    "../preset/src/__fixtures__/**",
    "../../node_modules",
    "../../dist"
  ]
}
