{
  "name": "highlight",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/highlight/src",
  "projectType": "library",
  "tags": ["type:highlight"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx packages/highlight/src/generator/index.ts"
      }
    },
    "generate:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx packages/highlight/src/generator/index.ts --watch"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/highlight/jest.config.ts"
      }
    }
  }
}
