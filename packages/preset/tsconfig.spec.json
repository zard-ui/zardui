{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "composite": true,
    "declaration": true,
    "paths": {
      "@zardui/preset": ["packages/preset/src/index.ts"],
      "@zardui/preset/*": ["packages/preset/src/*"]
    }
  },
  "include": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
