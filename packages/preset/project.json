{
  "name": "preset",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/preset/src",
  "projectType": "library",
  "tags": ["type:preset"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npx tsc -p packages/preset/tsconfig.lib.json --noEmit"],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/preset/jest.config.ts"
      }
    }
  }
}
