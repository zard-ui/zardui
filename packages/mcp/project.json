{
  "name": "mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/mcp/src",
  "projectType": "library",
  "tags": ["type:mcp"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/mcp/dist"],
      "options": {
        "commands": ["node scripts/mcp-build.mjs --package package.json"],
        "parallel": false
      }
    },
    "build:dev": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/packages/mcp/dist"],
      "options": {
        "commands": ["node scripts/mcp-build.mjs --package package.dev.json --link"],
        "parallel": false
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cd packages/mcp/dist && npm publish --access public"],
        "parallel": false
      },
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "packages/mcp/dist"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/mcp/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
